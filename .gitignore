__pycache__/
*.py[cod]
.ipynb_checkpoints/
.env
.DS_Store
*.zip

# Lake output. LOWROX_LAKE_ROOT can point anywhere, so the obvious names are
# listed and the Delta/control markers are matched at any depth — committing a
# lake means committing every Parquet file and every version of it.
lowrox_lake/
lake/
*_lake/
**/_delta_log/
**/_control/
**/bronze/
**/silver/
**/gold/

# Model and feature-store output. Same reasoning as the lake: artefacts are
# rebuilt by `python3 -m mlops.pipeline_ci`, and a .pkl in git is a binary
# nobody can review.
mlops_store/
*_store/
feature_store/
out/
predictions/
